# /etc/default/caddy-sentinel – Konfiguration des Sentinel-Panels

# Adresse des Panels. Standard nur lokal; von außen besser über Caddy
# (mit HTTPS) erreichbar machen, siehe README.
SENTINEL_LISTEN=127.0.0.1:7600

# Datenverzeichnis (SQLite-Datenbank mit allen Geheimnissen, Zertifikats-
# Spiegel). Nur für den Benutzer caddy-sentinel lesbar (0700).
SENTINEL_DATA=/var/lib/caddy-sentinel/data

# Agent-Token der lokalen Caddy-Instanz – Caddy (Gruppe caddy) muss es lesen.
# Caddy findet es ohne weitere Angabe unter diesem Pfad.
SENTINEL_TOKEN_FILE=/var/lib/caddy-sentinel/agent.token

# Prüf-Kopien der Konfiguration – Caddy (Gruppe caddy) muss sie lesen
SENTINEL_STAGING=/var/lib/caddy-sentinel/staging

# Caddy Admin-API (http://host:port oder unix//pfad/zum.sock). Standard: der
# Unix-Socket aus CADDY_ADMIN in /etc/systemd/system/caddy.service.d/sentinel.conf
# (nur Benutzer und Gruppe caddy). Setzt die Caddyfile selbst "admin …", muss
# dieser Wert dazu passen.
SENTINEL_CADDY_ADMIN=unix//run/caddy/admin.sock

# Haupt-Caddyfile; importierte Dateien im selben Verzeichnis sind im Editor bearbeitbar
SENTINEL_CADDYFILE=/etc/caddy/Caddyfile

# Caddy-Binary für "Vollständig prüfen" (caddy validate); leer = aus
SENTINEL_CADDY_BIN=/usr/local/bin/caddy

# SENTINEL_DEBUG=1

# Reverse-Proxys, deren X-Forwarded-For das Panel übernimmt (Anmelde-Sperren,
# Protokoll). Standard: nur localhost – also ein Caddy auf demselben Server.
# SENTINEL_TRUSTED_PROXIES=127.0.0.0/8,::1
